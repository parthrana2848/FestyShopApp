{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Update Prompt History",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/update-prompt-history.js"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "group": {
        "kind": "none",
        "isDefault": false
      }
    },
    {
      "label": "Auto-Update Prompt History (Watch)",
      "type": "shell",
      "command": "watch",
      "args": [
        "-n",
        "300",
        "node",
        "${workspaceFolder}/scripts/update-prompt-history.js"
      ],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    }
  ]
}
